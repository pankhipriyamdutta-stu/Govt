PROJECT_NAME="NESFIC-D-36 — Trusted Government Knowledge, Rules & Document Assistant"
ENVIRONMENT_NAME="DEMONSTRATION & PILOT ENVIRONMENT — NESFIC 2026"
DEMO_MODE=true

# Security & Tamper-Evident Signatures
SECRET_KEY="replace-with-a-cryptographically-secure-random-256bit-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Relational Database
# Default: SQLite (Instant zero-dependency development and demonstration)
DATABASE_URL="sqlite:///./backend_gov.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://nesfic_admin:password@localhost:5432/nesfic_db"

# AI Model Provider Configuration
# Optional: Provide Google Gemini API Key for online reasoning model integration
GEMINI_API_KEY=""
DEFAULT_MODEL_NAME="gemini-2.5-flash"

# Trust Policy & Grounding Constraints
ENFORCE_PRIMARY_AUTHORITY_ONLY=true
STRICT_ABSTENTION_THRESHOLD=0.85
